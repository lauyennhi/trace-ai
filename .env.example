# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (database that keeps all data) ---
# SUPABASE_URL: Your project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> "service_role" secret key.
# SERVER ONLY: never expose it in frontend code or commit it. The table has no public policies,
# so the public anon key cannot read or write the data.
SUPABASE_SERVICE_ROLE_KEY=

# SEED_DEMO_DATA: set to "false" for a clean production database (only the admin account is created).
SEED_DEMO_DATA=true

# ADMIN_PASSWORD: password of the admin account created when the database is empty (default 123456).
ADMIN_PASSWORD=

# SUPABASE_DB_PASSWORD: (Optional) Database password so the admin console can create the table for you
SUPABASE_DB_PASSWORD=

# DATABASE_URL: (Optional) PostgreSQL direct connection string
DATABASE_URL=

# AUTH_SECRET: Required in production. Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# GEMINI_MODEL: (Optional) Gemini model used for AI chat and process scoring. Default: gemini-3.5-flash (fallbacks: GEMINI_FALLBACK_MODELS, comma separated)
GEMINI_MODEL=
