# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# SUPABASE_ANON_KEY: Your Supabase Project Anon/Public API Key
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: (Optional) Your Supabase Project Service Role API Key for full backend access
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_DB_PASSWORD: (Optional) Your Supabase Database Password for auto-running migrations
SUPABASE_DB_PASSWORD=

# DATABASE_URL: (Optional) PostgreSQL direct connection string
DATABASE_URL=

# AUTH_SECRET: Required in production. Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# GEMINI_MODEL: (Optional) Gemini model used for AI chat and process scoring. Default: gemini-2.5-flash
GEMINI_MODEL=
